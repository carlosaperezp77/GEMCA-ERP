# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Firebase Configuration keys for manual programmatic initialization
# Users can save these keys inside the AI Studio Secrets panel.
FIREBASE_API_KEY=FIREBASE_API_KEY_PLACEHOLDER
FIREBASE_APPLICATION_ID=FIREBASE_APP_ID_PLACEHOLDER
FIREBASE_PROJECT_ID=FIREBASE_PROJECT_ID_PLACEHOLDER
